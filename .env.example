# PostgreSQL
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=change-me

# JWT (gere um valor aleatório forte para produção)
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Portas expostas no host pelo docker-compose (ajuste se já estiverem em uso)
BACKEND_PORT=8071
FRONTEND_PORT=8091

# Frontend (apenas para `npm run dev` fora do Docker)
VITE_API_BASE_URL=http://localhost:8071
